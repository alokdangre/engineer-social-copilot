{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": ["."],
  "graphs": {
    "profile": "./src/social_manager/agent/graphs/profile.py:profile_graph",
    "daily_capture": "./src/social_manager/agent/graphs/daily.py:daily_capture_graph",
    "ecosystem_research": "./src/social_manager/agent/graphs/research.py:ecosystem_research_graph",
    "recommendation_review": "./src/social_manager/agent/graphs/recommendation.py:recommendation_review_graph",
    "outcome_strategy": "./src/social_manager/agent/graphs/outcome.py:outcome_strategy_graph"
  },
  "env": {},
  "http": {
    "app": "./src/social_manager/main.py:app",
    "cors": {
      "allow_origins": ["http://localhost:3000"],
      "allow_methods": ["GET", "POST", "PATCH", "DELETE", "OPTIONS"],
      "allow_headers": ["Authorization", "Content-Type", "Idempotency-Key"],
      "allow_credentials": true
    },
    "logging_headers": {
      "excludes": ["authorization", "cookie", "set-cookie"]
    }
  }
}

