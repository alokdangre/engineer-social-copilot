APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret-for-development
# PostgreSQL with Docker (pgvector/pgvector:pg16)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/social_manager
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/social_manager
# Alternative local SQLite fallback:
# DATABASE_URL=sqlite+aiosqlite:///./social_manager.db
# CHECKPOINT_DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=social_manager_session

# Users add their own Gemini or OpenAI key after login in Settings.
# These server-wide keys are optional development/internal fallbacks only.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
REASONING_MODEL=gemini-2.5-flash
EXTRACTION_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Optional server-wide OpenAI fallback
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_REASONING_MODEL=gpt-4.1-mini
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Observability (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=social-media-manager-development
OTEL_EXPORTER_OTLP_ENDPOINT=

# Platform OAuth app credentials (server-side only; users connect through provider login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:8000/api/v1/connectors
